# Copy to backend/.env and fill in. All vars are prefixed DG_.

# --- LLM (OpenRouter) ---
DG_OPENROUTER_API_KEY=
# DG_PERSONA_MODEL=anthropic/claude-sonnet-4
# DG_CHAT_MODEL=anthropic/claude-3.5-haiku

# --- Embeddings ---
# local (default, no key) or openai (any OpenAI-compatible /embeddings endpoint)
# DG_EMBEDDING_PROVIDER=local
# DG_EMBEDDING_API_KEY=
# DG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# DG_EMBEDDING_MODEL=text-embedding-3-small

# --- Polling / retrieval ---
# DG_POLL_INTERVAL_SECONDS=900
# DG_TOP_K=8
